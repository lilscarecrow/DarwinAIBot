# Bot config (contains secrets)
config.json

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Logs
logs/*.log

# Runtime screenshots (errors and results — generated automatically)
screenshots/

# Calibration output (machine-specific, generated at runtime)
calibration_screenshots/
calibration_log.json
CALIBRATION_NOTES.md

# Loose reference/calibration images at repo root
*.png

# OpenCV template images (binary, machine-specific captures)
templates/

# noble-hopper proxy component (separate project)
noble-hopper/

# OpenH264 codec DLL (machine-specific runtime dependency, not source — see CLAUDE.md)
openh264-*.dll

# TwitchIO's default OAuth token store (contains live access/refresh tokens)
.tio.tokens.json

# Claude Code session data
.claude/

# OS
.DS_Store
Thumbs.db
